{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Storybook",
            "type": "shell",
            "command": "pnpm",
            "args": ["run", "storybook"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "fileLocation": "relative",
                "pattern": {
                    "regexp": "^.*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "vite",
                    "endsPattern": "localhost"
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
