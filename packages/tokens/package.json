{
  "name": "@langchain/macaw-tokens",
  "version": "1.7.23",
  "description": "Framework-independent CSS design tokens for Macaw.",
  "homepage": "https://github.com/langchain-ai/macaw-design-system#readme",
  "bugs": {
    "url": "https://github.com/langchain-ai/macaw-design-system/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langchain-ai/macaw-design-system.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "scripts": {
    "build": "node ../../scripts/build-tokens.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "{workspaceRoot}/scripts/build-tokens.mjs",
          "{workspaceRoot}/packages/components/src/cli-foundations.mts",
          "{workspaceRoot}/packages/components/docs/DESIGN.md",
          "{workspaceRoot}/packages/components/docs/STYLES.md",
          "{workspaceRoot}/packages/components/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
