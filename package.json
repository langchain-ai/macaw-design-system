{
  "name": "macaw-design-system",
  "version": "1.0.0-beta.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "build:watch": "node scripts/watch-build.mjs",
    "storybook": "storybook dev -p 6006 -c packages/components/.storybook",
    "build:storybook": "storybook build -c packages/components/.storybook -o storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint packages scripts vite.config.ts vitest.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify:types:bundler": "tsc --noEmit -p tests/consumer/tsconfig.bundler.json",
    "verify:types:nodenext": "tsc --noEmit -p tests/consumer/tsconfig.nodenext.json",
    "verify:types": "pnpm verify:types:bundler && pnpm verify:types:nodenext",
    "verify:package": "node scripts/verify-package.mjs && pnpm verify:types",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:package && pnpm build:storybook",
    "pack:check": "pnpm build && pnpm verify:package && node scripts/pack.mjs",
    "release:version": "nx release version",
    "release:changelog": "nx release changelog",
    "release:publish": "nx release publish",
    "design-system": "node packages/components/src/cli.mts",
    "macaw": "node packages/cli/dist/cli.mjs"
  },
  "devDependencies": {
    "@langchain/macaw-cli": "workspace:*",
    "@langchain/macaw-components": "workspace:*",
    "@langchain/macaw-tokens": "workspace:*",
    "@nx/js": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-links": "^10.2.8",
    "@storybook/react-vite": "^10.2.8",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-scale-chromatic": "^3.0.0",
    "@types/linkify-it": "5.0.0",
    "@types/node": "^25.2.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@visx/tooltip": "^4.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jiti": "2.4.2",
    "jsdom": "30.0.1",
    "nx": "23.2.1",
    "oxc-parser": "0.137.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.2",
    "storybook": "^10.2.8",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.8",
    "vitest-fail-on-console": "^0.10.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.27.0"
}
