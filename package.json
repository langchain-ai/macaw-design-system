  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && nx vite:build && tsc -p tsconfig.build.json && node scripts/rewrite-declaration-specifiers.mjs && pnpm build:styles && node scripts/copy-assets.mjs",
    "build:watch": "node scripts/watch-build.mjs",
    "build:styles": "tailwindcss -c tailwind.config.cjs -i ./src/styles/tailwind.css -o ./dist/utilities.css --minify",
    "storybook": "nx serve:storybook -p 6006",
    "build:storybook": "nx build-storybook -o storybook-static",
    "typecheck": "nx vite:typecheck",
    "test": "nx vitest:test run",
    "lint": "oxlint src scripts vite.config.ts vitest.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify:types:bundler": "nx vite:typecheck --noEmit -p tests/consumer/tsconfig.bundler.json",
    "verify:types:nodenext": "nx vite:typecheck --noEmit -p tests/consumer/tsconfig.nodenext.json",
    "verify:types": "pnpm verify:types:bundler && pnpm verify:types:nodenext",
    "verify:package": "node scripts/verify-package.mjs && pnpm verify:types",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:package && pnpm build:storybook",
    "pack:check": "pnpm build && pnpm verify:package && npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "node scripts/verify-license.mjs",
    "prepack": "pnpm build && pnpm verify:package",
    "design-system": "node src/cli.mts"
  },
